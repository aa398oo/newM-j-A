<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 联机：接收 Minecraft 局域网世界的 224.0.2.60:4445 多播广播。 -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.vulkan.level" android:required="false" />

    <application
        android:name=".MineportApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:allowNativeHeapPointerTagging="false"
        android:requestLegacyExternalStorage="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mineport"
        android:largeHeap="true"
        android:hardwareAccelerated="true">

        <!-- 主页全站横屏（UX-14）：横屏高度只有约 400dp，导航改成左侧 rail。
             允许左右翻转（sensorLandscape），不锁死一个方向。
             旋转不重建 Activity：这套界面没有需要重新解析的配置，重建只会把
             导航状态和滚动位置复位。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.Mineport"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 游戏画面单独一个 Activity：横屏、无标题栏、禁截屏可选。
             跑在 :game 独立进程：JVM/GL 崩溃只杀游戏进程，启动器界面还能留
             下来展示错误与导出诊断（主进程的 hwui 线程池也不会被 JVM 牵连）。 -->
        <activity
            android:name=".game.GameActivity"
            android:exported="false"
            android:process=":game"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.Mineport.Game" />

        <!-- 诊断包分享：filesDir 是应用私有目录，只能经 FileProvider 临时授权。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
